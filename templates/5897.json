          "parameters": {
            "text": "\u53d7\u3051\u3068\u3063\u305f3\u3064\u306equery\u3092\u4e00\u3064\u305a\u3064Tavily_Search_Tool\u306bquery\u3068\u3057\u3066\u6e21\u3057\u30663\u3064\u306equery\u306b\u95a2\u3057\u3066\u8abf\u67fb\u3092\u5b9f\u884c\u3057\u691c\u7d22\u30af\u30a8\u30ea\u3068\u8abf\u67fb\u7d50\u679c\u3092\u7701\u7565\u305b\u305a\u306b\u30a2\u30a6\u30c8\u30d7\u30c3\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3002",
            "options": {
